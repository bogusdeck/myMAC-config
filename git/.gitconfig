[user]
	email = tanishvashisth@gmail.com
	name = bogusdeck
[core]
	editor = nano
[safe]
	directory = /Users/bogusdeck/Projects
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f

[includeIf "gitdir:~/work/"]
	path = ~/.gitconfig-work

